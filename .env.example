# ============================================================
# .env.example — Variables d'environnement du projet
# Copiez ce fichier en .env et adaptez les valeurs :
#   cp .env.example .env
# IMPORTANT : .env est dans .gitignore et ne doit JAMAIS être commité
# ============================================================

# --- Base de données Airflow ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=airflow

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Modèle ---
MODEL_NAME=Weather_RF_Model
MODEL_ALIAS=production

# --- Promotion (Quality Gate) ---
PROMOTION_RMSE_THRESHOLD=3.0

# --- Monitoring ---
DRIFT_THRESHOLD=0.5
MONITORING_WINDOW_SIZE=365

# --- Docker Hub (pour le CI/CD) ---
# DOCKERHUB_USERNAME=votre_username
# DOCKERHUB_TOKEN=votre_token
